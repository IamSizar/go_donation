<?xml version="1.0" encoding="utf-8"?>
<!-- The window background Android shows between tapping the icon and Flutter's
     first frame. It was the bare plate with nothing on it, so launching went
     white → logo, and the brand only appeared once Dart was running.

     The mark here is the SAME artwork the Flutter splash then draws, at the
     same place on screen, so the handover is invisible: the native screen
     stops and the animated one continues from the identical image. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
