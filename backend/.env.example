# Copy this file to .env and adjust if needed.
# Used by the Go server (added in Phase 2).

DATABASE_URL=postgres://humanitarian:humanitarian_dev_password@localhost:5435/humanitarian?sslmode=disable

# Server
# Locally we use HTTP_PORT. On Railway/Heroku/etc. the platform injects PORT,
# which the server prefers automatically — no change needed for deploys.
HTTP_PORT=8080
APP_ENV=development

# CORS — origins allowed to call the API from a browser (the admin dashboard).
# Comma-separated list. Deny-by-default: leaving this empty blocks all
# cross-origin browser requests (the mobile app and same-origin calls are
# unaffected). Set it to your dashboard URL in production, e.g.
# https://dashboard.up.railway.app — use "*" only for local dev / a
# deliberately fully-public API.
CORS_ALLOWED_ORIGINS=https://dashboard.up.railway.app

# Migrations — set to 1 to auto-apply backend/migrations/*.sql on startup
# (each runs once, tracked in schema_migrations). Use this on a FRESH database
# such as a new Railway Postgres. Leave unset for an existing local DB.
RUN_MIGRATIONS=
# Where the .sql files live relative to the working dir (default ./migrations).
MIGRATIONS_DIR=./migrations

# OTP (Phase 3a + 19)
# Sign-in is phone + OTP only. Demo mode is the interim while no SMS/WhatsApp
# gateway is configured: POST /api/auth/otp/request returns the code in the JSON
# response instead of sending it, which is the only way the app can show it.
# Demo is a FALLBACK, not a preference — the moment OTPIQ_API_KEY below is set,
# every request is served as a real out-of-band code and these two are ignored.
OTP_DEMO_ENABLED=1
OTP_DEMO_CODE=123456
# The code above is returned to whoever asks for it, so it authenticates nobody:
# anyone who knows a phone number can sign in as its owner. That is accepted for
# app users during the interim, but not for accounts that can reach the
# dashboard. Staff sign in with THIS code instead, which the server never prints
# — set it to a random 6 digits (it must differ from OTP_DEMO_CODE) and pass it
# to staff out of band. Leave it blank and staff accounts holding no password
# cannot sign in at all. Remove it once OTPIQ is live.
OTP_STAFF_DEMO_CODE=
# Per-IP rate limit for OTP requests (default 10/hour).
OTP_IP_MAX_REQUESTS_PER_HOUR=10

# OTPIQ (Phase 19) — real-mode delivery via WhatsApp with SMS fallback.
# Sign up at https://otpiq.com to get a key (format: sk_live_… / sk_test_…).
OTPIQ_API_KEY=
# whatsapp-sms = try WhatsApp first, fall back to SMS automatically.
OTPIQ_PROVIDER=whatsapp-sms
# Optional 11-char sender id; leave blank for OTPIQ default.
OTPIQ_SENDER_ID=

# Email (H20) — outbound SMTP, sent with the Go standard library (no new
# dependency). There is exactly one thing this sends today: the confirmation
# code that protects the MAIN-ADMIN account. That protection is deliberately
# FAIL-CLOSED, so read this before deploying:
#
#   * With these blank, a change to a super_admin's phone, email, password or
#     staff_tier is REFUSED with a message naming the missing variable. Nothing
#     is silently half-confirmed and no success is ever reported for an email
#     that did not leave the server. Every other account, and every other field
#     on a super_admin's own row, is unaffected.
#   * The confirmation ALSO needs a real SMS channel (OTPIQ_API_KEY above).
#     Demo OTP delivery is refused here on purpose: demo mode returns the code
#     to whoever asked for it, and a code handed to the person making the change
#     confirms nothing.
#   * Each protected super_admin account additionally needs BOTH a phone and an
#     email saved on it. The email is editable from المستخدمون → تعديل.
#
# SMTP_PORT: 587 = STARTTLS (default), 465 = implicit TLS. If a username or
# password is set, the server REFUSES to send over a relay that offers no TLS
# rather than putting the password on the wire.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase Cloud Messaging (FCM HTTP v1)
# Drop your service-account JSON at the path below and the server picks it up
# at startup. Without it, in-DB notifications still work but no push is delivered.
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json

# Google Sign-In (POST /api/auth/google)
# Comma-separated list of the OAuth Client IDs (Web + iOS + Android, as
# applicable) whose ID tokens the server will accept — create these in the
# Google Cloud Console (APIs & Services → Credentials). Without this set,
# GoogleConfigured() is false and every Google sign-in attempt gets an
# immediate "Google sign-in is not configured on the server" error — this
# was never set anywhere (local, .env.example, or the deploy docs) as of
# this writing, so Google Sign-In has never actually been reachable.
GOOGLE_OAUTH_CLIENT_IDS=

# AI Support Assistant (Phase 29)
# When ANTHROPIC_API_KEY is set, the in-app Support Assistant answers users
# with Claude (role-aware, can suggest in-app navigation, and can call tools
# to look up the caller's own wallet/donations/marriage/case/volunteer data).
# Without it, the assistant runs a built-in keyword engine over the same
# knowledge base, so it still works — just without free-form understanding
# or tool access. Also admin-toggleable at runtime (Settings → AI Assistant)
# without needing to unset this key.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5).
ASSISTANT_MODEL=

# ─── Media storage (uploads) ────────────────────────────────────────────────
# Where profile photos, ID cards, medical reports, partner logos, marketplace
# images and volunteer check-in evidence are written.
#
# This section exists because there was a data-loss bug here. The upload
# directory was hardcoded to "./images", the container's own working
# directory, and Railway replaces the container filesystem on every deploy —
# so each release silently deleted every file any user had ever uploaded,
# while the database kept the paths. A row went on claiming a photo existed
# and the URL behind it answered 404, which reads as a broken image viewer
# rather than as data that is simply gone. Found when a volunteer's check-in
# photo 404'd minutes after uploading successfully.
#
# Two backends, selected entirely by whether the R2 block below is filled in.
# The choice is logged at startup ("[uploads] new uploads -> ..."), so an
# operator can confirm it without uploading something and hunting for it.

# LOCAL DISK (development, and any deploy with no R2 block).
# Defaults to ./images when unset. In production this MUST be a mounted
# persistent volume — the variable is only half the fix, the volume has to
# exist. This directory is also still served at /images/* regardless of which
# backend is active, because every row written before the move to R2 holds a
# relative "images/..." path that only resolves through that route.
UPLOAD_DIR=

# CLOUDFLARE R2 (production). ALL FIVE or NONE — a partial configuration is
# refused at startup and the app will not boot. That is deliberate: falling
# back to local disk on a typo'd variable name would reproduce the original
# data-loss bug exactly (green deploy, uploads still succeeding, files still
# disappearing every release), and one refused start is cheaper than a week
# of unnoticed loss.
#
# R2_ACCOUNT_ID is the Cloudflare account id; the S3 endpoint is derived from
# it as https://<account>.r2.cloudflarestorage.com.
# R2_PUBLIC_BASE_URL is the PUBLIC host that serves the bucket — a custom
# domain bound to it, or its r2.dev URL. It is NOT the S3 endpoint above:
# that one is authenticated and is for writing, this one is what a browser or
# the app fetches an image from. It must be an absolute http(s) URL; a
# scheme-less value ("media.example.org") is rejected at startup, because it
# would be stored in the database and every client would mistake it for a
# relative path and prefix its own API origin onto it.
#
# Avoid a path containing "/api/images/" in R2_PUBLIC_BASE_URL: the Flutter
# client rewrites that exact segment inside profile-picture URLs
# (lib/api/profile_api.dart, normalizeProfilePictureUrl) as a legacy fix-up,
# and it would mangle an otherwise-valid CDN URL.
#
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are credentials: never commit
# them, never log them. The startup line names only the bucket and the public
# base.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
