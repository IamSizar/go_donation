{
  "name": "admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:labels": "node scripts/check-labels.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test:sw": "node scripts/test-sw.mjs",
    "test:nav": "node --test scripts/test-nav-layout.mjs",
    "test:field-labels": "node --test scripts/test-field-labels.mjs",
    "check:pending-parity": "node scripts/check-pending-parity.mjs",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-3000}",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:feed-bodies": "node --experimental-strip-types scripts/check-feed-bodies.mjs"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.1"
  }
}
